# Copia este archivo a .env y ajusta los valores
# SECRET_KEY y ADMIN_PASSWORD son OBLIGATORIOS — la app no arranca sin ellos.

# Base de datos PostgreSQL — OBLIGATORIO para docker-compose
DB_USER=gestion
DB_PASSWORD=<PLACEHOLDER>
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_db
# DATABASE_URL opcional: si se define sobreescribe los valores anteriores
# DATABASE_URL=postgresql://usuario:contraseña@host:5432/nombre_db

# Servidor PowerShell (host Windows)
# En Docker usa: host.docker.internal
# En local usa: 127.0.0.1
POWERSHELL_SERVER=127.0.0.1
POWERSHELL_PORT=12345
SOCKET_TIMEOUT=10

# Flask
# Genera SECRET_KEY con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Clave de cifrado de columnas sensibles (email, nombre). NO cambiar una vez en producción.
# Genera con: python -c "import secrets; print(secrets.token_hex(32))"
FIELD_ENCRYPTION_KEY=
FLASK_DEBUG=False

# CORS — orígenes permitidos separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:5000

# Autenticación — superadmin inicial (mínimo 12 caracteres, mayúscula, número, especial)
ADMIN_USER=admin
ADMIN_PASSWORD=<PLACEHOLDER>

# Caché (segundos)
CACHE_TIME=3

# Backup
BACKUP_PATH=C:\Backups

# Retención de métricas históricas (días)
METRICS_RETENTION_DAYS=30

# Entorno — activa HTTPS forzado en Talisman y SESSION_COOKIE_SECURE
FLASK_ENV=production

# TLS para comunicación con servidor PowerShell
# 1. Arrancar Server-powershell.ps1 — exporta ps-server-cert.pem automáticamente
# 2. Copiar ps-server-cert.pem al directorio del proyecto (se monta en /app/)
# 3. Habilitar:
PS_TLS_ENABLED=true
PS_SERVER_CA_CERT=/app/ps-server-cert.pem

# ─────────────────── SMTP / Notificaciones por email ───────────────────
# Activa el envío de correos. Si está en false, send_email() es no-op
# (útil en dev sin MailHog/SMTP). El resto de variables se ignoran.
MAIL_ENABLED=true

# ── Desarrollo: MailHog (incluido en docker-compose, interfaz en http://localhost:18025/8025) ──
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# ── Producción Gmail: descomenta y rellena estas líneas ──
#docker compose exec -e TEST_MAIL_TO=tu@gmail.com flask python /app/send_test_emails.py
# Obtén la contraseña de aplicación en: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# SMTP_TIMEOUT=15

# Identidad del remitente
MAIL_FROM=alertas@gestion.local
MAIL_FROM_NAME=Control Remoto Windows
